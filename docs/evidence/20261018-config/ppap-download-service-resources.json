[
  {
    "metadata": {
      "name": "ppap-download-service"
    },
    "spec": {
      "template": {
        "metadata": {
          "annotations": {
            "autoscaling.knative.dev/maxScale": "20",
            "run.googleapis.com/client-name": "gcloud",
            "run.googleapis.com/client-version": "575.0.0",
            "run.googleapis.com/cloudsql-instances": "msp-zabbix:asia-northeast1:msp-customer-portal-db",
            "run.googleapis.com/startup-cpu-boost": "true"
          }
        },
        "spec": {
          "containers": {
            "resources": {
              "limits": {
                "cpu": "1000m",
                "memory": "512Mi"
              }
            }
          }
        }
      }
    }
  }
]