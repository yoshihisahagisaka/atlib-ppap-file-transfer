# このファイルはテンプレートです。実際の値は絶対にコミットしないこと。
# 本番(Cloud Run)ではこれらは Secret Manager / --set-env-vars 経由で注入する。

NODE_ENV=development
PORT=8080

# GCP
GCP_PROJECT_ID=msp-zabbix

# DB (既存の msp-customer-portal-db インスタンスに新規データベース/ユーザーを作成して使う想定。
#     本番は Cloud SQL Unix socket 経由。ローカル開発時は Cloud SQL Auth Proxy かローカルPostgresを使う)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ppap_transfer
DB_USER=ppap_app
DB_PASSWORD=change-me-in-local-dev-only
# Cloud Run本番用(設定されていればこちらを優先しUnixソケット接続する)
DB_SOCKET_PATH=

# ファイル保存先バケット(非公開。署名付きURLでのみアクセス)
STORAGE_BUCKET=atlib-ppap-file-transfer

# SMTP (本番は Secret Manager: ppap-smtp-password。msp-customer-portalと同様 smtp.gmail.com + アプリパスワード)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=change-me@atlib.jp
SMTP_PASSWORD=change-me
SMTP_FROM=noreply@atlib.jp

# Cloud IAP (upload-serviceのみ・本番必須)。同一Cloud Runサービスに相乗りする複数backend service
# (一般アクセス用ppap-upload-bes、監査ログ専用ppap-audit-bes)それぞれのaudience文字列をカンマ区切りで。
# 例: /projects/123456789012/global/backendServices/1111111111111111111,/projects/123456789012/global/backendServices/2222222222222222222
IAP_AUDIENCE=

# 受信者向けダウンロードページのベースURL(upload-serviceが通知メールのリンク生成に使用)
DOWNLOAD_BASE_URL=https://files.atlib.jp

# ウイルススキャンサービス(ppap-virus-scan)のURL。upload-serviceのみ・本番必須。
# /completeでこのURLへ同期呼び出しし、スキャン完了(DB更新・通知メール送信含む)を待ってから応答する。
SCAN_SERVICE_URL=https://ppap-virus-scan-xxxxxxxxxxxx.asia-northeast1.run.app

# 送信設定
TRANSFER_DEFAULT_EXPIRES_DAYS=7
TRANSFER_MAX_EXPIRES_DAYS=14
TRANSFER_MAX_DOWNLOADS=3
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
SIGNED_URL_EXPIRES_MINUTES=5
MAX_UPLOAD_SIZE_MB=200

# ウイルス検出時などの社内通知先(任意)
STAFF_NOTIFY_EMAIL=change-me@atlib.jp
