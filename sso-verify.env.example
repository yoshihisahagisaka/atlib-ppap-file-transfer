# sso-verify-server専用の環境変数テンプレート。実際の値は絶対にコミットしないこと。
# 既存の .env.example (upload/download/scan用)とは別ファイルにして汚さない。
# 本番(Cloud Run)ではこれらは Secret Manager / --set-env-vars 経由で注入する。

NODE_ENV=development
PORT=8080

# GCP (2026-08-25にmsp-zabbixから分離。Secret Managerはatlib-sso-verify-spike側を見る)
GCP_PROJECT_ID=atlib-sso-verify-spike

# DB (msp-zabbixプロジェクトの既存 msp-customer-portal-db インスタンスへクロスプロジェクト接続。
#     本番の ppap_transfer/ppap_app とは別のデータベース/ユーザーとして
#     ppap_sso_verify / ppap_sso_verify_app を作成して使う。
#     ローカル開発時は Cloud SQL Auth Proxy かローカルPostgresを使う)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ppap_sso_verify
DB_USER=ppap_sso_verify_app
DB_PASSWORD=change-me-in-local-dev-only
DB_SOCKET_PATH=

# 共有config.tsが引き続きrequired()にしているが、このサービスでは未使用のダミー値
# (本番のGCSバケット・SMTPシークレットには一切アクセスしない)。
STORAGE_BUCKET=unused-sso-verify-spike
SMTP_HOST=unused
SMTP_PORT=587
SMTP_USER=unused
SMTP_PASSWORD=unused
SMTP_FROM=unused@atlib.jp

# --- ここからSSO検証スパイク専用 ---

# Google Cloud Console > APIs & Services > Credentials で作成したOAuthクライアント(Webアプリケーション)。
# 詳細手順は docs/SSO検証_スパイク手順書.md を参照。
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/auth/google/callback

# Microsoft Entra管理センター > アプリの登録 で作成したアプリ登録(シングルテナント、検証用)。
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT_ID=
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:8080/auth/microsoft/callback

# state/session Cookie署名用のランダム値。`openssl rand -base64 32` 等で生成する。
SSO_SESSION_SECRET=

# JITプロビジョニングの既定座席上限(sso_verify_customersに個別値が無い場合のフォールバック。
# 現状のスキーマは常にcustomers.seat_capを使うため、将来の拡張余地として残してあるだけで未使用)。
SSO_SEAT_CAP_DEFAULT=3
